{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/infra-guard.py\" 2>>~/.claude/hook-errors.log || true"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/issue-dup-guard.py\" 2>>~/.claude/hook-errors.log || true"
          }
        ]
      }
    ]
  }
}

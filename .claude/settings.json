{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/infra-guard.py\" 2>>~/.claude/hook-errors.log || true"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/issue-dup-guard.py\" 2>>~/.claude/hook-errors.log || true"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/adr-guard.py\" 2>>~/.claude/hook-errors.log || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import json,sys\ntry:\n    p = (json.load(sys.stdin).get(\"tool_input\") or {}).get(\"file_path\") or \"\"\nexcept Exception:\n    sys.exit(0)\nif p.endswith(\".kt\"):\n    print(json.dumps({\"systemMessage\":\"Lembrete: antes do PR, rode o skill quality-gate (detekt + coverage + ArchUnit) no subprojeto tocado.\"}))\n' 2>>~/.claude/hook-errors.log || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/diagram-guard.py\" 2>>~/.claude/hook-errors.log || true"
          }
        ]
      }
    ]
  }
}
